# Optional: silence each fetch script's progress/summary output, printing
# only warnings/errors (e.g. an unresolved email). snipe_it_sync.py still
# prints the diff and final status line. Useful for monitoring/Nagios checks
# where the normal output is just noise. Defaults to false.
# QUIET=true

# Optional (Docker only): NAGIOS=true implies QUIET=true, and additionally
# has docker-entrypoint.sh collapse the whole run's stdout into a single
# line with literal \n sequences instead of real newlines — the format
# Nagios expects so it can split short vs. long output itself. Set this via
# `docker run -e NAGIOS=true` rather than here if you also run the tool
# outside Docker for non-monitoring uses. Defaults to false.
# NAGIOS=true

# Microsoft 365 / Entra ID (Azure AD app registration)
# Required permissions: User.Read.All, LicenseAssignment.Read.All, Organization.Read.All
MS_TENANT_ID=11111111-2222-3333-4444-555555555555
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=your-client-secret-here
# Optional: comma-separated SKU part numbers to drop from license reports
# (free/trial SKUs with no real license cost). Defaults are hardcoded in
# microsoft_licenses.py if this isn't set.
MS_EXCLUDED_SKUS=POWER_BI_STANDARD,Power_Pages_vTrial_for_Makers,FLOW_FREE

# Atlassian (Jira Cloud) — classic (unscoped) API token
# Scoped tokens don't work: group/group-member endpoints aren't covered
# by Atlassian's scoped-token support and 401 regardless of granted scopes.
# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_SITE_URL=https://yourcompany.atlassian.net
ATLASSIAN_USER=admin@yourcompany.com
ATLASSIAN_API_TOKEN=your-classic-token-here
# Optional: Jira masks emailAddress entirely for some external/guest accounts
# (not managed by your org) — no API call can recover it regardless of token
# permissions. Manually map accountId -> email for those here. JSON object
# string. Find the accountId in a WARNING line printed by atlassian_licenses.py.
# ATLASSIAN_ACCOUNT_EMAIL_OVERRIDES={"5b10a2844c20165700ede21g":"jane.doe@example.com"}

# Slack — Bot Token
# Required OAuth scopes: users:read, users:read.email
# Create at: https://api.slack.com/apps → your app → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Bitbucket Cloud — Atlassian API token with scopes (app = Bitbucket)
# Required scope: read:workspace:bitbucket
# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
# Note: this is a DIFFERENT token type than ATLASSIAN_API_TOKEN above — the
# classic Jira token has no Bitbucket scopes and won't work here.
# BITBUCKET_WORKSPACE is your workspace slug — find it in the workspace URL
# at bitbucket.org (Bitbucket's cross-workspace listing API was permanently
# removed, so this can't be auto-discovered).
BITBUCKET_API_TOKEN=your-bitbucket-scoped-token-here
BITBUCKET_WORKSPACE=yourworkspaceslug
# Optional: only needed if the Bitbucket token's account uses a different
# login email than ATLASSIAN_USER above.
# BITBUCKET_USER=admin@yourcompany.com

# Snipe-IT — personal API token
# Create at: your Snipe-IT URL → Account (top right) → Manage API Keys
SNIPE_IT_URL=https://yoursnipeit.example.com
SNIPE_IT_API_TOKEN=your-snipe-it-token-here
# Defaults to true (dry run — only reports the diff, no writes). Set to
# false to actually perform the checkout/checkin calls against Snipe-IT.
SNIPE_IT_DRY_RUN=true
# Maps product/SKU keys (from the *_licenses.json files) to exact Snipe-IT
# license names (case-sensitive). JSON object string. Defaults are hardcoded
# in snipe_it_sync.py if this isn't set.
SNIPE_IT_LICENSE_MAP={"jira-software":"Jira","confluence":"Confluence","confluence-guest":"Confluence guest access","jira-servicedesk":"Jira","jira-core":"Jira","EXCHANGESTANDARD":"Microsoft Exchange Online (Plan 1)","INTUNE_A":"Microsoft Intune","O365_BUSINESS_ESSENTIALS":"Microsoft 365 Business Basic","O365_BUSINESS_PREMIUM":"Microsoft 365 Business Standard","owner":"Slack","admin":"Slack","member":"Slack","guest-multi-channel":"Slack","guest-single-channel":"Slack","bitbucket":"Bitbucket"}
# Optional: maps a known alias email to its canonical email, so the same
# person isn't diffed as two different people when systems disagree on their
# address (e.g. a ".ext" marker added during an account transition on one
# side only). JSON object string, alias -> canonical. Empty by default.
SNIPE_IT_EMAIL_ALIASES={"alias@yourcompany.com":"canonical@yourcompany.com"}
